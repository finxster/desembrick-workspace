# Source this file to use the desembrick command from any directory:
#   source /path/to/desembrick-workspace/desembrick.env

DESEMBRICK_WORKSPACE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-${(%):-%x}}")" && pwd)"

desembrick() {
  "${DESEMBRICK_WORKSPACE_ROOT}/bin/desembrick" "$@"
}

# Short alias.
dbrick() {
  "${DESEMBRICK_WORKSPACE_ROOT}/bin/desembrick" "$@"
}
